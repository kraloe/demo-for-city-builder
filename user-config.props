<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Edit these to point to your GLFW and GLAD installs (or vcpkg). -->
  <PropertyGroup Label="UserMacros">
    <GlfwIncludeDir>$(ProjectDir)third_party\glfw\include</GlfwIncludeDir>
    <GlfwLibDir>$(ProjectDir)third_party\glfw\lib</GlfwLibDir>
    <GladIncludeDir>$(ProjectDir)third_party\glad\include</GladIncludeDir>
    <GladSrcDir>$(ProjectDir)third_party\glad\src</GladSrcDir>
    <StbIncludeDir>$(ProjectDir)third_party\stb</StbIncludeDir>
  </PropertyGroup>
</Project>
